# Copy to .env and adjust. Docker Compose reads .env for variable substitution
# in compose.yml. Django itself only reads real environment variables (no dotenv).
# All values here are local-development placeholders. Never commit a real .env.

DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
ALLOWED_HOSTS=*

# Postgres (Compose builds DATABASE_URL for the backend from these three)
POSTGRES_DB=contratofacil
POSTGRES_USER=contratofacil
POSTGRES_PASSWORD=change-me

# Only needed when running Django outside Docker against Postgres.
# Without it, Django falls back to SQLite (backend/db.sqlite3).
# DATABASE_URL=postgresql://contratofacil:change-me@localhost:5432/contratofacil

REDIS_URL=redis://redis:6379/0
# 1 runs Celery tasks inline (no worker needed). Compose sets 0.
CELERY_TASK_ALWAYS_EAGER=1

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ContratoFácil <contratos@example.com>

# Shared secret expected in the X-Webhook-Secret header of POST /webhooks/pix/
# (local placeholder; set a long random value anywhere outside your machine)
PIX_WEBHOOK_SECRET=change-me
